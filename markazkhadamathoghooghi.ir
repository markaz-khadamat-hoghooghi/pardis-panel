<title>مرکز جامع خدمات حقوقی | رضا چرمدوزی</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap');
:root{--navy:#101d2b;--navy2:#172a3e;--navy3:#213b53;--gold:#c9a45c;--gold2:#e5ca91;--ink:#172536;--muted:#68788a;--paper:#f5f7fa;--white:#fff;--line:#e4e9ef;--green:#187b5a;--shadow:0 18px 50px rgba(16,29,43,.09)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Vazirmatn',Tahoma,sans-serif;line-height:1.9}button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}.container{width:min(1160px,calc(100% - 40px));margin:auto}
.topline{height:5px;background:linear-gradient(90deg,var(--gold),#f2dfb5,var(--gold))}.header{background:var(--navy);color:#fff;position:relative;overflow:hidden}.header:after{content:"";position:absolute;width:460px;height:460px;border:1px solid rgba(229,202,145,.12);border-radius:50%;left:-160px;top:-270px;box-shadow:0 0 0 45px rgba(229,202,145,.025),0 0 0 90px rgba(229,202,145,.02)}.nav{height:86px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;z-index:1}.brand{display:flex;align-items:center;gap:13px}.brand-mark{width:48px;height:48px;border:1px solid var(--gold);border-radius:14px;display:grid;place-items:center;color:var(--gold2);font-size:25px}.brand-name{font-weight:800;font-size:17px;line-height:1.5}.brand-sub{font-size:11px;color:#aebbc8}.nav-links{display:flex;align-items:center;gap:25px;color:#d6dfe8;font-size:13px}.nav-links a:hover{color:var(--gold2)}.nav-cta{background:var(--gold);color:var(--navy);font-weight:800;padding:9px 18px;border-radius:9px;font-size:13px}
.hero{position:relative;z-index:1;padding:65px 0 78px;display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:50px}.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--gold2);font-size:12px;font-weight:700;letter-spacing:.2px}.eyebrow:before{content:"";width:25px;height:1px;background:var(--gold)}.hero h1{font-size:clamp(29px,4.4vw,51px);line-height:1.55;margin:15px 0 13px;font-weight:900;max-width:700px}.hero h1 span{color:var(--gold2)}.hero-copy{color:#c0ccd7;font-size:15px;max-width:650px;margin:0 0 25px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;padding:12px 20px;border:0;border-radius:10px;cursor:pointer;font-weight:800;font-size:13px;transition:.2s}.btn-gold{background:var(--gold);color:var(--navy)}.btn-gold:hover{background:var(--gold2);transform:translateY(-1px)}.btn-outline{border:1px solid #627488;color:#fff;background:transparent}.hero-aside{border:1px solid rgba(229,202,145,.25);background:linear-gradient(145deg,rgba(255,255,255,.08),rgba(255,255,255,.025));border-radius:22px;padding:25px;backdrop-filter:blur(5px)}.hero-aside .seal{width:62px;height:62px;border:1px solid var(--gold);border-radius:18px;display:grid;place-items:center;color:var(--gold2);font-size:30px;margin-bottom:15px}.hero-aside h3{margin:0 0 7px;font-size:17px}.hero-aside p{color:#bac7d2;font-size:12px;margin:0}.hero-points{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}.hero-point{border-top:1px solid rgba(255,255,255,.14);padding-top:10px;color:#e4eaf0;font-size:12px}.hero-point b{display:block;color:var(--gold2);font-size:18px}
.trustbar{background:#fff;border-bottom:1px solid var(--line)}.trust-items{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;padding:18px 0}.trust-item{display:flex;align-items:center;gap:11px;color:var(--muted);font-size:12px}.trust-icon{width:35px;height:35px;flex:none;background:#f4efe4;color:#9b7838;border-radius:11px;display:grid;place-items:center;font-size:17px}.trust-item b{display:block;color:var(--ink);font-size:13px}
.section{padding:64px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.kicker{color:#9b7838;font-size:11px;font-weight:800}.section-title{font-size:27px;line-height:1.5;margin:4px 0 0;font-weight:900;color:var(--navy)}.section-desc{color:var(--muted);font-size:13px;margin:7px 0 0}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.service{background:#fff;border:1px solid var(--line);border-radius:16px;padding:19px;min-height:195px;display:flex;flex-direction:column;transition:.2s;box-shadow:0 5px 18px rgba(16,29,43,.025)}.service:hover{transform:translateY(-4px);border-color:#d6c092;box-shadow:var(--shadow)}.service-icon{width:43px;height:43px;border-radius:13px;background:#f4efe4;color:#94733a;display:grid;place-items:center;font-size:21px;margin-bottom:12px}.service h3{font-size:14px;margin:0 0 5px;color:var(--navy)}.service p{font-size:11px;color:var(--muted);margin:0 0 15px;flex:1;line-height:1.9}.service button{border:0;background:none;color:#9b7838;font-weight:800;text-align:right;padding:0;cursor:pointer;font-size:11px}.service button:hover{color:var(--navy)}
.process{background:var(--navy);color:#fff}.process .section-title{color:#fff}.process .section-desc{color:#bac7d2}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:27px}.step{border-top:1px solid #3a4b5d;padding-top:17px}.step-num{color:var(--gold2);font-size:12px;font-weight:900}.step h3{font-size:14px;margin:5px 0}.step p{font-size:11px;color:#b8c4d0;margin:0}
.workspace{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}.box{background:#fff;border:1px solid var(--line);border-radius:18px;padding:25px;box-shadow:0 8px 28px rgba(16,29,43,.035)}.box-head{display:flex;gap:12px;align-items:center;margin-bottom:17px}.box-icon{width:42px;height:42px;background:#f4efe4;border-radius:13px;display:grid;place-items:center;color:#94733a;font-size:20px}.box h2{font-size:18px;margin:0;color:var(--navy)}.box-head p{margin:2px 0 0;color:var(--muted);font-size:11px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:flex;flex-direction:column;gap:5px;font-size:11px;color:#536477;font-weight:700}.field.full{grid-column:1/-1}.field input,.field select,.field textarea{width:100%;border:1px solid #dce3eb;background:#fbfcfd;border-radius:9px;padding:10px 12px;color:var(--ink);outline:none;font-size:12px}.field input:focus,.field select:focus,.field textarea:focus{border-color:#b99a5c;box-shadow:0 0 0 3px rgba(201,164,92,.13)}.field textarea{min-height:112px;resize:vertical}.field small{font-size:10px;color:#8290a0;font-weight:400}.form-actions{grid-column:1/-1;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.form-actions .btn{min-width:145px}.hint{font-size:10px;color:#788697;margin:0}.notice{background:#fff8e9;border:1px solid #f0dfb9;color:#80632f;padding:11px 13px;border-radius:10px;font-size:10px;margin-top:15px}.result{display:none;margin-top:14px;padding:13px;border-radius:10px;background:#eaf6f0;color:#176746;font-size:12px;overflow-wrap:anywhere}.result.error{background:#fff0ef;color:#a33b35}.result strong{display:block;font-size:14px;margin-bottom:4px}.track-result{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.track-row{background:#f6f8fa;border-radius:9px;padding:9px;font-size:11px}.track-row b{display:block;color:#788697;font-size:10px}.track-row span{font-weight:700;overflow-wrap:anywhere}.status{display:inline-block;background:#f5ecd9;color:#89682e;border-radius:20px;padding:2px 9px;font-size:10px}
.faq{display:grid;grid-template-columns:1fr 1fr;gap:12px}.faq details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px}.faq summary{cursor:pointer;font-size:12px;font-weight:800;color:var(--navy)}.faq p{font-size:11px;color:var(--muted);margin:10px 0 0}.footer{background:#0b1723;color:#b6c2cd;padding:30px 0 20px}.footer-inner{display:flex;justify-content:space-between;gap:20px;align-items:center}.footer strong{color:#fff}.footer p{font-size:11px;margin:4px 0}.footer small{font-size:10px;color:#82909d}.mobile-menu{display:none}
@media(max-width:900px){.hero{grid-template-columns:1fr .7fr;gap:25px}.service-grid{grid-template-columns:repeat(3,1fr)}.steps{grid-template-columns:repeat(2,1fr)}}
@media(max-width:650px){.container{width:min(100% - 28px,560px)}.nav{height:72px}.brand-name{font-size:14px}.brand-sub{font-size:10px}.nav-links{display:none}.hero{grid-template-columns:1fr;padding:43px 0 48px;gap:25px}.hero h1{font-size:31px}.hero-copy{font-size:13px}.hero-aside{padding:18px}.trust-items{grid-template-columns:1fr;gap:10px;padding:14px 0}.section{padding:45px 0}.section-head{display:block}.section-title{font-size:23px}.service-grid{grid-template-columns:repeat(2,1fr);gap:10px}.service{padding:14px;min-height:190px}.workspace{grid-template-columns:1fr}.box{padding:18px}.form-grid{grid-template-columns:1fr}.field.full,.form-actions{grid-column:auto}.steps{grid-template-columns:1fr 1fr;gap:15px}.faq{grid-template-columns:1fr}.footer-inner{display:block}.footer-inner>div+div{margin-top:14px}.track-result{grid-template-columns:1fr 1fr}}
@media(max-width:380px){.service-grid{grid-template-columns:1fr}.hero-actions .btn{width:100%}.steps{grid-template-columns:1fr}}
</style>
